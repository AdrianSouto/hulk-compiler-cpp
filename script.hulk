// Test arithmetic and logical operations
print(5 + 3);
print(10 - 4);
print(6 * 7);
print(15 / 3);
print(17 % 5);
print(2 ** 3);

// Test decimal numbers
print(3.14 + 2.86);
print(10.5 - 3.2);
print(2.5 * 4.0);
print(9.6 / 2.4);

// Test negative numbers
print(-5);
print(-3.14);
print(-5 + 10);
print(-(2 + 3));

// Test logical operations
print(5 == 5);
print(3 != 4);
print(7 > 5);
print(4 < 8);
print(6 >= 6);
print(3 <= 7);
print(true && false);
print(true | false);
print(!true);

// Test string concatenation
print("Hello" @ " " @ "World");
print("A" @@ "B");

// Test complex expressions
print((5 + 3) * 2 - 1);
print(2 ** 3 + 4 * 5);
print(!(5 > 3) | (2 == 2));