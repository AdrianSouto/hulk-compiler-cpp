function operate(x, y) {
    print(x + y);
    print(x - y);
    print(x * y);
    print(x / y);
};


function id(value) => value;


let a = 10, b = 5 in {
    print("--- Initial Operate Call ---");
    operate(a, b);

    let k = a, z = 20 in {
        print("--- Second Operate Call ---");
        operate(k, z);
    };
};

print("--- Let Operate Call ---");
let d = 2, e = 3 in operate(d, e);


print("--- Inline Functions ---");
function cot(x) => 1 / tan(x);
function tan(x) => sin(x) / cos(x);
function duplicate(x) => x * 2;

print(tan(PI) ** 2 + cot(PI) ** 2);

print("--- Conditionals ---");
let a = 42 in if (a % 2 == 0) print("Even") else print("odd");

let a = 42 in print(if (a % 2 == 0) "even" else "odd");

let a = 42,  mod = a % 3 in
    print(
        if (mod == 0) "Magic"
        elif (mod % 3 == 1) "Woke"
        else "Dumb"
    );

let a = 42, mod = a % 3 in
    print(
        if (mod == 0) "Magic"
        elif (mod % 3 == 1) "Woke"
        else "Dumb"
    );


print("--- Loops - 1 ---");


let a = 5 in while (a >= 0) {
    print(a);
    a := a - 1;
};

print("--- Loops - 2 ---");


let a = 5 in while (a >= 0) {
    print(if (a % 2 == 0  ) duplicate(a) else a  );
    a := a - 1;
};

print("--- Loops 3 ---");

for (x in range(0, 11)) print(x);

print("-----Recursion----");

function fib(n) => if (n == 0 | n == 1) 1 else fib(n-1) + fib(n-2);

function fact(x) => let f = 1 in for (i in range(1, x+1)) f := f * i;

function gcd(a, b) => if (b == 0) a else gcd(b, a % b);

function power(b, exp) => if (exp == 0) 1 else b * power(b, exp -1 );

print(fib(5));
print(fact(5));
print("GCD of 54 and 24 is: " @ gcd(54, 24));
print("2 to the power of 5 is: " @ power(2, 5));

print("-----Types-----");


type Animal(name: String, age: Number) {
    name: String = name;
    age: Number = age;

    getName(): String => self.name;
    getAge(): Number => self.age;

    speak(): String => "Some generic animal sound";

};


type Mammal inherits Animal {

    speak(): String => "Mammal sound: " @ base();

};


type Dog inherits Mammal {
    speak(): String => "Woof! (Dog speaking, parent says: " @ base() @ ")";
};

let dog = new Dog("Buddy", 5) in {
    print("Dog details:");
    print("Name: " @ dog.getName());
    print("Age: " @ dog.getAge());
    print("Speaks : " @ dog.speak());

};

let mammal = new Mammal("Generic Mammal", 3) in {
    print("Mammal details:");
    print("Name: " @ mammal.getName());
    print("Age: " @ mammal.getAge());
    print("Speaks : " @ mammal.speak());
};

