type Superman {

};

let x = new Bird() in
    print(
        if (x is Bird) "It's bird!"
        elif (x is Plane) "It's a plane!"
        else "No, it's Superman!"
    );

type Person {
    name : String = "John";
    age : Number = 25;
    isActive : Boolean = true;


    getName() : String => self.name;
    getAge() : Number => self.age;
    getIsActive() : Boolean => self.isActive;


    setName(newName : String) => self.name := newName;
    setAge(newAge : Number) => self.age := newAge;
    setIsActive(active : Boolean) => self.isActive := active;
};

let person = new Person() in {
    print("Initial values:");
    print("Name: " @ person.getName());
    print("Age: " @ person.getAge());
    print("Active: " @ person.getIsActive());

    person.setName("Jane");
    person.setAge(30);
    person.setIsActive(false);

    print("After updates:");
    print("Name: " @ person.getName());
    print("Age: " @ person.getAge());
    print("Active: " @ person.getIsActive());
};


